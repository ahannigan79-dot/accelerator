# AI Delivery Factory environment. Copy to .env.local for dev; set the same in Vercel.

# --- Anthropic (AI specialist workers) ---
# Optional. Without it the Factory runs fully with deterministic controls and
# human decisions; AI recommendations are marked UNAVAILABLE instead of generated.
ANTHROPIC_API_KEY=
# Model used by specialist workers (defaults to claude-opus-5).
FACTORY_MODEL=claude-opus-5

# --- Persistence ---
# Auto-injected when you attach a Postgres store in Vercel. When unset, the
# Factory persists engagements as JSON files under data/engagements (dev only).
POSTGRES_URL=

# --- Release identity (read-only; shown in the UI) ---
FACTORY_VERSION=1.4-rc4
